# SSH keys - never commit private keys
*id_ed25519*
!*id_ed25519*.pub
*id_rsa*
!*id_rsa*.pub
*.pem
*.ppk

# Ansible
*.retry
.vault_pass
vault_pass.txt
*.vault_pass
# vault.yml files hold real credentials and must stay unencrypted only
# locally, if at all -- if you do commit one, encrypt it with `ansible-vault
# encrypt` first and remove it from this ignore. .example templates are
# always safe to commit.
# (inventory/group_vars/windows_vms/vault.yml is ansible-vault-encrypted and
# intentionally committed -- the vault password itself lives only in
# /root/.ansible-secrets/cyberrange_vault_pass on the Kali WSL control node,
# never in git.)
!vault.yml.example

# Secrets / local overrides
secrets.yml
*.secrets.yml
.env

# Generated vulnerable-range credentials/assignments (the 1000-account pool,
# per-account password + role mapping, etc.) -- doubles as a "solutions key"
# for the lab, must never be committed. README.md documents what lives here.
ansible/generated/*
!ansible/generated/README.md

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
