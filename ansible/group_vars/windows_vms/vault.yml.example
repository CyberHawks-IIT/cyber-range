# Template for the vaulted Windows credential used by inventory/hosts.yml.
#
# 1. Copy this file to vault.yml in the same directory.
# 2. Retrieve the current shared password by running this on the Proxmox
#    host (do NOT commit the plaintext value anywhere):
#      qm cloudinit dump <any-vmid> user
# 3. Fill in the real value below, then encrypt the file in place:
#      ansible-vault encrypt group_vars/windows_vms/vault.yml
#    vault.yml (encrypted) is safe to commit; this .example file is the only
#    copy that should ever hold a real password unencrypted, and it never
#    should.

vault_windows_admin_password: "CHANGE_ME"
