;SQL Server unattended install -- Database Engine only, mixed-mode auth.
;Generated by the mssql_server Ansible role. See defaults/main.yml.
[OPTIONS]
ACTION="Install"
FEATURES={{ mssql_features }}
INSTANCENAME="{{ mssql_instance_name }}"
INSTANCEID="{{ mssql_instance_name }}"
QUIET="True"
QUIETSIMPLE="False"
IACCEPTSQLSERVERLICENSETERMS="True"
UPDATEENABLED="False"
SQLSVCACCOUNT="{{ mssql_svc_account }}"
SQLSVCSTARTUPTYPE="Automatic"
AGTSVCACCOUNT="NT AUTHORITY\NETWORK SERVICE"
AGTSVCSTARTUPTYPE="Manual"
;Mixed mode: both Windows and SQL logins. SAPWD is passed on the setup command
;line by the role, not stored here.
SECURITYMODE="SQL"
SQLSYSADMINACCOUNTS={% for a in mssql_sysadmin_accounts %}"{{ a }}"{{ " " if not loop.last else "" }}{% endfor %}

TCPENABLED="1"
NPENABLED="1"
BROWSERSVCSTARTUPTYPE="Automatic"
