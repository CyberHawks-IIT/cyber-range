<Sysmon schemaversion="4.90">
  <EventFiltering>
    <!-- Event 1: scoped to the one Sysmon-based detection that needs it
         (splunk-detections backlog, "Lateral movement" -> WMI remote
         execution: a child process of WmiPrvSE.exe). Logging every process
         creation domain-wide would multiply this range's Splunk volume many
         times over for no detection that actually consumes it. -->
    <RuleGroup name="ProcessCreateInclude" groupRelation="or">
      <ProcessCreate onmatch="include">
        <ParentImage condition="end with">WmiPrvSE.exe</ParentImage>
      </ProcessCreate>
    </RuleGroup>

    <!-- Event 10: scoped to LSASS access (credential-dumping detection),
         with an allowlist for the two legitimate accessors the backlog
         calls out by name (Defender's own scanner and the WMI provider
         host), both of which touch LSASS as part of normal operation and
         would otherwise drown the real signal. -->
    <RuleGroup name="ProcessAccessInclude" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <RuleGroup name="ProcessAccessExclude" groupRelation="or">
      <ProcessAccess onmatch="exclude">
        <SourceImage condition="end with">MsMpEng.exe</SourceImage>
      </ProcessAccess>
      <ProcessAccess onmatch="exclude">
        <SourceImage condition="end with">WmiPrvSE.exe</SourceImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Events 17/18 (named pipe created/connected) were tried and removed
         2026-09-27 -- do not re-add without a new reason. The original
         design keyed the Coercion trigger detection off Sysmon pipe events
         for the coercion RPC calls (PetitPotam/DFSCoerce/ShadowCoerce/
         PrinterBug/CheeseOunce). Live-tested exhaustively, including
         fixing a real stale-config bug (the file matched this repo but the
         running Sysmon driver had never been told to reload it) and
         cross-checking the complete real pipe list against both
         PetitPotam's and Coercer's actual source (efsrpc/lsarpc/samr/
         lsass/netlogon for MS-EFSR, spoolss/netdfs/Fssagentrpc/eventlog for
         the others) -- Event 18 (PipeConnected) never fires for a remote
         SMB-based pipe connection regardless of which pipe name is
         configured, confirmed via a real PetitPotam attack against dc1
         with the complete pipe list active and Event 18 confirmed capable
         of firing at all (for unrelated local process-to-pipe activity).
         The working replacement is splunk-detections' "Forced
         Authentication" detection, which watches the coerced host's own
         resulting outbound SMB connection via Zeek's conn.log instead --
         see that detection's YAML for the full investigation trail. -->

    <!-- Events 19/20/21: WMI event filter/consumer/binding created. Feeds
         the WMI-event-subscription-persistence detection. Nothing to scope
         down further: a WMI event subscription being registered at all is
         already a rare, high-signal event on these hosts. -->
    <RuleGroup name="WmiEvents" groupRelation="or">
      <WmiEvent onmatch="exclude" />
    </RuleGroup>
  </EventFiltering>
</Sysmon>
